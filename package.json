{
  "name": "telegram-repo-dispatcher",
  "version": "0.2.0",
  "description": "Talk to multiple omp instances from one Telegram supergroup — each topic is a repo, each message spawns omp -p.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pomofomo/multi-claude-tg.git"
  },
  "bin": {
    "trd": "./bin/trd-shim.js"
  },
  "files": [
    "bin/trd-shim.js",
    "bin/trd-darwin-arm64",
    "bin/trd-darwin-amd64",
    "bin/trd-linux-amd64",
    "bin/trd-linux-arm64",
    "scripts/install.sh",
    "postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node postinstall.js",
    "build": "bash scripts/build-binaries.sh",
    "build:current": "go build -o bin/trd ./cmd/trd"
  },
  "engines": {
    "node": ">=18"
  }
}
