{
  "name": "telegram-repo-dispatcher",
  "version": "0.2.0",
  "description": "Talk to multiple omp instances from one Telegram supergroup — each topic is a repo, each message spawns omp -p.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pomofomo/multi-omp-tg.git"
  },
  "bin": {
    "trd": "./bin/trd-shim.js"
  },
  "files": [
    "bin/trd-shim.js",
    "cmd/",
    "internal/",
    "go.mod",
    "go.sum",
    "scripts/install.sh",
    "scripts/build-binaries.sh",
    "Makefile",
    "postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node postinstall.js",
    "build": "bash scripts/build-binaries.sh",
    "build:current": "CGO_ENABLED=1 go build -o bin/trd ./cmd/trd"
  },
  "engines": {
    "node": ">=18"
  }
}
